# Never put real secrets in this file.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://rag:change-me-local-only@postgres:5432/rag

REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=local-minio
MINIO_SECRET_KEY=change-me-local-only
MINIO_BUCKET=rag-artifacts

OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me-local-only

RETRIEVAL_PROFILE=sota_mvp
MODEL_PROVIDER=openrouter
MODEL_GATEWAY_URL=http://model-gateway:8080
MOCK_PROVIDER_URL=http://mock-provider:8080
MOCK_PROVIDER_OUTPUT_MODE=normal
API_PUBLIC_BASE_URL=http://localhost:8000
XBERG_URL=http://xberg:8000
XBERG_URLS=
DOCLING_URL=http://docling:5001
DOCLING_URLS=
METADATA_SERVICE_URL=http://metadata-service:8090
DOCUMENT_PARSER_SERVICES_REQUIRED=true
DOCUMENT_PARSER_TIMEOUT_SECONDS=180
DOCUMENT_PARSER_XBERG_CONCURRENCY=2
DOCUMENT_PARSER_DOCLING_CONCURRENCY=1
DOCUMENT_INGESTION_ITEM_CONCURRENCY=2
DOCUMENT_SOFT_DELETE_RETENTION_DAYS=30
UPLOAD_SESSION_TTL_SECONDS=900
UPLOAD_MAX_BYTES=104857600
UPLOAD_JSON_MAX_DEPTH=32
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

AUTH_DISABLED=false
WORKSPACE_RESET_ENABLED=false
AUTH_MODE=local
APP_SECRET_FILE=/run/secrets/app_secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
SESSION_COOKIE_NAME=wikipediarag_session
SESSION_IDLE_SECONDS=2592000
SESSION_MAX_SECONDS=2592000
REMEMBER_ME_IDLE_SECONDS=2592000
REMEMBER_ME_MAX_SECONDS=7776000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_SCOPE=openid profile email
OIDC_CLAIM_SUB=sub
OIDC_CLAIM_USERNAME=preferred_username
OIDC_CLAIM_NAME=name
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_EMAIL_VERIFIED=email_verified
OIDC_CLAIM_GROUPS=groups
OIDC_CLAIM_REALM_ROLES=realm_access.roles
OIDC_AUTO_PROVISION_DOMAINS=
OIDC_AUTO_PROVISION_GROUPS=
OIDC_AUTO_PROVISION_ROLES=
OIDC_PLATFORM_ADMIN_ROLES=
OIDC_GROUP_CATALOG_SYNC_ENABLED=false
OIDC_GROUP_SYNC_ENABLED=false
OIDC_GROUP_JIT_CREATION_ENABLED=false

EVAL_AUTH_MODE=local
EVAL_AUTH_USERNAME=admin
EVAL_AUTH_PASSWORD=admin

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROVIDER_TIMEOUT_SECONDS=180
MODEL_CLIENT_CHAT_TIMEOUT_SECONDS=300
MODEL_CLIENT_EMBEDDING_TIMEOUT_SECONDS=240
MODEL_CLIENT_RERANK_TIMEOUT_SECONDS=240
CHAT_RUN_DEADLINE_SECONDS=300
OPERATION_HEARTBEAT_SECONDS=10
DEPENDENCY_CIRCUIT_FAILURE_THRESHOLD=3
DEPENDENCY_CIRCUIT_COOLDOWN_SECONDS=15
IDEMPOTENCY_RECORD_TTL_SECONDS=86400
SAFE_EXTERNAL_RETRY_ATTEMPTS=2
MODELS_CONFIG_PATH=/app/config/models.yaml
RETRIEVAL_CONFIG_PATH=/app/config/retrieval.yaml

WIKI_XML_PATH=/data/ruwiki-20260701-pages-articles-multistream.xml.bz2
WIKI_INDEX_PATH=/data/ruwiki-20260701-pages-articles-multistream-index.txt.bz2
WIKI_SNAPSHOT_ID=ruwiki-20260701
EMBEDDING_DIMENSIONS=64

ZIM_DIR=/zim
ZIM_FILENAME=
KIWIX_PUBLIC_BASE_URL=http://localhost:8083
KIWIX_INTERNAL_BASE_URL=http://kiwix:8080
KIWIX_BOOK_NAME=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
TELEMETRY_CONTENT_CAPTURE=off
TELEMETRY_MAX_TEXT_CHARS=256
TELEMETRY_RETENTION_DAYS=30
